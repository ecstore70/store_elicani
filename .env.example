# =============================================================================
# Elicani — variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie para .env.local (desenvolvimento) e preencha com os valores reais.
# Nunca comite credenciais reais: .env* está no .gitignore (exceto este arquivo).
#
# Onde encontrar os valores:
#   https://supabase.com/dashboard → seu projeto → Project Settings → API
# =============================================================================

# --- Supabase (obrigatório) ---------------------------------------------------

# URL pública do projeto Supabase.
# Ex.: https://yudpfpoaqdzvrpmuvitv.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave "anon" (pública). Segura para o browser — só é limitada pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" (PRIVILEGIADA).
#   - NUNCA é embutida no bundle do browser (o prefixo NEXT_PUBLIC_ não está aqui).
#   - Usada apenas por scripts de verificação/testes fora da aplicação.
#   - Se perder, gere outra no dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# --- Domínios -----------------------------------------------------------------
# Arquitetura de domínios do Elicani:
#   elicani.site        → site de marketing
#   app.elicani.site    → APLICAÇÃO do lojista (autenticação + painel)
#   {slug}.elicani.site → vitrines públicas (NUNCA usadas em Auth redirects)

# Base da aplicação do lojista — todos os redirects do Supabase Auth
# (confirmação de e-mail, recuperação de senha) derivam desta variável.
# Produção: https://app.elicani.site   Desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site de marketing (apenas metadados/OpenGraph; nunca participa de Auth).
# Produção: https://elicani.site   Desenvolvimento: http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# Domínio base das lojas públicas: {slug}.<NEXT_PUBLIC_STORE_DOMAIN>
# Local: localhost  →  http://maria-fashion.localhost:3000
# Produção: elicani.site  →  https://maria-fashion.elicani.site
NEXT_PUBLIC_STORE_DOMAIN=localhost
